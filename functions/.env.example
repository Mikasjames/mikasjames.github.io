# Template for functions/.env.<projectId> (gitignored — never commit real values).
# Firebase loads .env and .env.<projectId> from this directory at deploy time;
# all keys become runtime env vars for every function in this codebase.

AI_PROVIDER=gemini
GITHUB_OWNER=your-github-username
GITHUB_REPO=your-repo-name

# AI prompts follow the AI_PROMPT_* naming convention.
# Format rules:
#   - Wrap multi-line prompts in SINGLE quotes; inner double quotes stay literal.
#   - Never use ' inside the prompt text (it terminates the value).
#   - Save the file with LF line endings (CRLF can leak \r into multiline values).
#   - Changing a prompt requires a redeploy: firebase deploy --only functions
AI_PROMPT_JOURNAL_ANALYSIS='Your journal analysis system prompt here'
